{
  "$schema": "https://opencode.ai/schemas/agent-metadata.json",
  "schema_version": "1.0.0",
  "description": "Custom .opencode project metadata for AgentHarmony. This file defines custom agent configurations, subagents, and their dependencies for registry management and orchestration.",
  "project": {
    "name": "AgentHarmony",
    "type": "custom",
    "framework": "opencode",
    "version": "1.0.0"
  },
  "agents": {
    "harmony-agent": {
      "id": "harmony-agent",
      "name": "HarmonyAgent",
      "category": "core",
      "type": "agent",
      "version": "1.0.0",
      "author": "opencode",
      "tags": ["universal", "coordination", "primary", "orchestration"],
      "dependencies": [
        "subagent:the-conductor",
        "subagent:coder-agent",
        "subagent:ContextSniffer",
        "context:standards-code",
        "context:standards-docs",
        "context:standards-tests"
      ]
    },
    "the-conductor": {
      "id": "the-conductor",
      "name": "TheConductor",
      "category": "subagents/core",
      "type": "subagent",
      "version": "2.0.0",
      "author": "opencode",
      "tags": ["task-breakdown", "planning", "coordination"],
      "dependencies": ["context:task-delegation-basics"]
    },
    "ContextSniffer": {
      "id": "ContextSniffer",
      "name": "ContextSniffer",
      "category": "subagents/core",
      "type": "subagent",
      "version": "1.0.0",
      "author": "opencode",
      "tags": ["context", "discovery", "search"],
      "dependencies": []
    },
    "coder-agent": {
      "id": "coder-agent",
      "name": "CoderAgent",
      "category": "subagents/code",
      "type": "subagent",
      "version": "1.0.0",
      "author": "opencode",
      "tags": ["coding", "implementation"],
      "dependencies": ["context:standards-code"]
    }
  },
  "defaults": {
    "agent": {
      "version": "1.0.0",
      "author": "opencode",
      "type": "agent",
      "tags": []
    },
    "subagent": {
      "version": "1.0.0",
      "author": "opencode",
      "type": "subagent",
      "tags": []
    }
  }
}
